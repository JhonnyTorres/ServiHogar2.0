{
  "expo": {
    "name": "ServiHogar",
    "slug": "ServiHogar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/png-transparent-construction-tools-with-helmet-thumbnail.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/png-transparent-construction-tools-with-helmet-thumbnail.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D4ED8"
        }
      ],
      "expo-sharing"
    ]
  }
}
